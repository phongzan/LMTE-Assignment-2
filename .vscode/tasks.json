{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "${workspaceFolder}\\.tools\\cmake-4.4.4-windows-x86_64\\bin\\cmake.exe",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}\\build", "-G", "Visual Studio 17 2022", "-A", "x64"],
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "${workspaceFolder}\\.tools\\cmake-4.4.4-windows-x86_64\\bin\\cmake.exe",
            "args": ["--build", "${workspaceFolder}\\build", "--config", "Debug", "--parallel"],
            "dependsOn": "CMake: Configure",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: Test",
            "type": "shell",
            "command": "${workspaceFolder}\\.tools\\cmake-4.4.4-windows-x86_64\\bin\\ctest.exe",
            "args": ["--test-dir", "${workspaceFolder}\\build", "-C", "Debug", "--output-on-failure"],
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        }
    ]
}
